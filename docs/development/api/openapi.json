{
  "components": {
    "schemas": {
      "ErrorBody": {
        "description": "Standard error payload returned by every failed request.",
        "properties": {
          "error": {
            "description": "Human-readable description of the error.",
            "example": "An error message",
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "GetListUserResponse": {
        "description": "User returned by a successful lookup.",
        "properties": {
          "email": {
            "description": "Email address of the user, when one was provided.",
            "format": "email",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "$ref": "#/components/schemas/i64",
            "description": "Unique identifier of the user."
          },
          "role": {
            "$ref": "#/components/schemas/Role",
            "description": "Role of the user."
          },
          "username": {
            "description": "Username of the user.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "role",
          "username"
        ],
        "type": "object"
      },
      "GetMeResponse": {
        "description": "Current user returned by a successful lookup.",
        "properties": {
          "email": {
            "description": "Email address of the caller, when one was provided.",
            "format": "email",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "$ref": "#/components/schemas/i64",
            "description": "Unique identifier of the caller."
          },
          "role": {
            "$ref": "#/components/schemas/Role",
            "description": "Role of the caller."
          },
          "username": {
            "description": "Username of the caller.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "role",
          "username"
        ],
        "type": "object"
      },
      "GetUploadResponse": {
        "description": "State of an upload session returned by a successful lookup.",
        "properties": {
          "bitmap": {
            "description": "One character per chunk, `1` when received and `0` otherwise.",
            "example": "110",
            "type": "string"
          },
          "expires_at": {
            "description": "Date and time at which the upload session expires, as\n`YYYY-MM-DDTHH:MM:SS`.",
            "example": "2026-01-01T12:00:00",
            "type": "string"
          },
          "file_id": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/i64",
                "description": "Unique identifier of the finished file, when the upload is finished."
              }
            ]
          },
          "is_finished": {
            "description": "Whether the upload session has been finished.",
            "type": "boolean"
          },
          "total_chunks": {
            "description": "Total number of chunks the upload is split into.",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "bitmap",
          "expires_at",
          "is_finished",
          "total_chunks"
        ],
        "type": "object"
      },
      "GetUserResponse": {
        "description": "User returned by a successful lookup.",
        "properties": {
          "email": {
            "description": "Email address of the user, when one was provided.",
            "format": "email",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "$ref": "#/components/schemas/i64",
            "description": "Unique identifier of the user."
          },
          "role": {
            "$ref": "#/components/schemas/Role",
            "description": "Role of the user."
          },
          "username": {
            "description": "Username of the user.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "role",
          "username"
        ],
        "type": "object"
      },
      "HealthResponse": {
        "description": "Service health status.",
        "properties": {
          "status": {
            "description": "Service status.",
            "example": "ok",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "LoginRequest": {
        "description": "Payload to authenticate a user.",
        "properties": {
          "password": {
            "description": "Password used to authenticate.",
            "type": "string",
            "writeOnly": true
          },
          "username": {
            "description": "Username of the user to authenticate.",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "password",
          "username"
        ],
        "type": "object"
      },
      "LoginResponse": {
        "description": "Token issued by a successful authentication.",
        "properties": {
          "access_token": {
            "description": "Token to present in the `Authorization` header of subsequent requests.",
            "type": "string"
          },
          "expires_in": {
            "description": "Lifetime of the token, in seconds.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "token_type": {
            "description": "Token type, always `bearer`.",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "expires_in",
          "token_type"
        ],
        "type": "object"
      },
      "PatchCredentialRequest": {
        "description": "Payload to change the password behind a credential.",
        "properties": {
          "password": {
            "description": "New password; never returned by the API.\n\nMust be at least 8 characters long and contain at least one symbol\n(a non-alphanumeric character).",
            "minLength": 8,
            "pattern": "[^A-Za-z0-9]",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "password"
        ],
        "type": "object"
      },
      "PatchUserRequest": {
        "description": "Payload to update the profile of a user.\n\nEvery attribute is optional; an omitted attribute leaves the stored value\nunchanged.",
        "properties": {
          "email": {
            "description": "New email address.",
            "format": "email",
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Role",
                "description": "New role. Only the Root Admin may change the role of a user."
              }
            ]
          },
          "username": {
            "description": "New username; must be at least 4 characters long.",
            "minLength": 4,
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "PatchUserResponse": {
        "description": "Updated user returned by a successful update.",
        "properties": {
          "email": {
            "description": "Email address of the user, when one was provided.",
            "format": "email",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "$ref": "#/components/schemas/i64",
            "description": "Unique identifier of the user."
          },
          "role": {
            "$ref": "#/components/schemas/Role",
            "description": "Role of the user."
          },
          "username": {
            "description": "Username of the user.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "role",
          "username"
        ],
        "type": "object"
      },
      "PostUploadCheckRequest": {
        "description": "Payload checking for an already stored file.",
        "properties": {
          "md5": {
            "description": "MD5 digest of the complete file, as a 32-character hexadecimal string.",
            "example": "d41d8cd98f00b204e9800998ecf8427e",
            "maxLength": 32,
            "minLength": 32,
            "type": "string"
          }
        },
        "required": [
          "md5"
        ],
        "type": "object"
      },
      "PostUploadCheckResponse": {
        "description": "Result of a check for an already stored file.",
        "properties": {
          "file_id": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/i64",
                "description": "Unique identifier of the matching file, when the caller owns one."
              }
            ]
          }
        },
        "type": "object"
      },
      "PostUploadCompleteRequest": {
        "description": "Payload completing an upload session.",
        "properties": {
          "upload_id": {
            "$ref": "#/components/schemas/i64",
            "description": "Unique identifier of the upload session to complete."
          }
        },
        "required": [
          "upload_id"
        ],
        "type": "object"
      },
      "PostUploadCompleteResponse": {
        "description": "File finalized by a successful completion.",
        "properties": {
          "file_id": {
            "$ref": "#/components/schemas/i64",
            "description": "Unique identifier of the stored file."
          }
        },
        "required": [
          "file_id"
        ],
        "type": "object"
      },
      "PostUploadRequest": {
        "description": "Payload initializing an upload session.",
        "properties": {
          "content_type": {
            "description": "Declared media type of the file content.",
            "example": "video/mp4",
            "type": "string"
          },
          "file_name": {
            "description": "Name of the file being uploaded.",
            "example": "clip.mp4",
            "minLength": 1,
            "type": "string"
          },
          "file_size": {
            "description": "Total size of the file being uploaded, in bytes.",
            "example": 1048576,
            "format": "int64",
            "minimum": 1,
            "type": "integer"
          },
          "md5": {
            "description": "MD5 digest of the complete file, as a 32-character lowercase\nhexadecimal string.",
            "example": "d41d8cd98f00b204e9800998ecf8427e",
            "maxLength": 32,
            "minLength": 32,
            "type": "string"
          }
        },
        "required": [
          "content_type",
          "file_name",
          "file_size",
          "md5"
        ],
        "type": "object"
      },
      "PostUploadResponse": {
        "description": "Upload session created by a successful initialization.",
        "properties": {
          "chunk_size": {
            "description": "Fixed size of every chunk except the last, in bytes.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "expires_at": {
            "description": "Date and time at which the upload session expires, as\n`YYYY-MM-DDTHH:MM:SS`.",
            "example": "2026-01-01T12:00:00",
            "type": "string"
          },
          "upload_id": {
            "$ref": "#/components/schemas/i64",
            "description": "Unique identifier of the upload session."
          }
        },
        "required": [
          "chunk_size",
          "expires_at",
          "upload_id"
        ],
        "type": "object"
      },
      "PutUploadChunkRequest": {
        "description": "Raw bytes of one chunk.\n\nThe handler extracts the body as raw bytes. It is declared as a binary\n`String` so the `OpenAPI` schema describes the raw `application/octet-stream`\npayload instead of the JSON array of integers a bare `Vec<u8>` would produce.",
        "format": "binary",
        "type": "string"
      },
      "PutUploadChunkResponse": {
        "description": "Response of a successfully stored chunk.",
        "properties": {
          "received": {
            "description": "Whether the chunk has been received.",
            "type": "boolean"
          }
        },
        "required": [
          "received"
        ],
        "type": "object"
      },
      "RegisterRequest": {
        "description": "Payload to register a new user.\n\nThe requested `role` is granted only when the authenticated caller is\nallowed to create it: the Root Admin can register `Admin` or `Standard`\nusers, an `Admin` user can register `Standard` users only.",
        "properties": {
          "email": {
            "description": "Email address of the new user, when provided.",
            "format": "email",
            "type": [
              "string",
              "null"
            ]
          },
          "password": {
            "description": "Password of the new user; never returned by the API.\n\nMust be at least 8 characters long and contain at least one symbol\n(a non-alphanumeric character).",
            "minLength": 8,
            "pattern": "[^A-Za-z0-9]",
            "type": "string",
            "writeOnly": true
          },
          "role": {
            "$ref": "#/components/schemas/Role",
            "description": "Role to grant to the new user."
          },
          "username": {
            "description": "Username of the new user.",
            "maxLength": 100,
            "minLength": 4,
            "type": "string"
          }
        },
        "required": [
          "password",
          "role",
          "username"
        ],
        "type": "object"
      },
      "RegisterResponse": {
        "description": "User created by a successful registration.",
        "properties": {
          "email": {
            "description": "Email address of the newly registered user, when one was provided.",
            "format": "email",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "$ref": "#/components/schemas/i64",
            "description": "Unique identifier of the newly registered user."
          },
          "role": {
            "$ref": "#/components/schemas/Role",
            "description": "Role granted to the newly registered user."
          },
          "username": {
            "description": "Username of the newly registered user.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "role",
          "username"
        ],
        "type": "object"
      },
      "Role": {
        "description": "Role of a `User`.",
        "enum": [
          "ADMIN",
          "STANDARD"
        ],
        "type": "string"
      },
      "i64": {
        "format": "int64",
        "type": "integer"
      }
    },
    "securitySchemes": {
      "bearer_auth": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "HTTP API of the Mnemorium service",
    "license": {
      "identifier": "MIT",
      "name": "MIT"
    },
    "title": "Mnemorium API",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/asset/upload": {
      "post": {
        "description": "Validates the declared content type, file name, size and MD5 digest, creates\nthe upload session and its staging file, and returns the session identifier,\nthe fixed chunk size and the expiry instant.",
        "operationId": "post_upload",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostUploadRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostUploadResponse"
                }
              }
            },
            "description": "Upload session created"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Invalid payload"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Missing or invalid credentials"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The declared file size exceeds the maximum allowed size"
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The declared content type is not a supported media type"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unexpected error"
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ],
        "summary": "Initialize an upload session",
        "tags": [
          "asset"
        ]
      }
    },
    "/asset/upload/check": {
      "post": {
        "description": "Returns the identifier of the matching file, or `null` when the caller owns\nno file with that digest. The lookup is caller-scoped: a file owned by\nanother user is not reported.",
        "operationId": "post_upload_check",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostUploadCheckRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostUploadCheckResponse"
                }
              }
            },
            "description": "Check completed"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Invalid payload"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Missing or invalid credentials"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unexpected error"
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ],
        "summary": "Check for an existing file",
        "tags": [
          "asset"
        ]
      }
    },
    "/asset/upload/complete": {
      "post": {
        "description": "Verifies the recomputed MD5 digest, deduplicates against the caller's\nexisting files and, on success, registers the file and marks the upload as\nfinished. Completion is idempotent: completing an already finished upload\nreturns the caller's file for the same digest.",
        "operationId": "post_upload_complete",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostUploadCompleteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostUploadCompleteResponse"
                }
              }
            },
            "description": "Upload completed"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Invalid payload, incomplete upload or integrity mismatch"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Missing or invalid credentials"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unknown upload session"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The digest is already owned by another user"
          },
          "410": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Upload session expired"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unexpected error"
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ],
        "summary": "Complete an upload session",
        "tags": [
          "asset"
        ]
      }
    },
    "/asset/upload/{upload_id}": {
      "get": {
        "description": "Returns the received-chunk bitmap, the total number of chunks, the expiry\ninstant, whether the upload is finished and, when it is, the identifier of\nthe finished file.",
        "operationId": "get_upload",
        "parameters": [
          {
            "description": "Identifier of the upload session",
            "in": "path",
            "name": "upload_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/i64"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetUploadResponse"
                }
              }
            },
            "description": "Upload session found"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Invalid upload session identifier"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Missing or invalid credentials"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unknown upload session"
          },
          "410": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Upload session expired"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unexpected error"
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ],
        "summary": "Fetch the state of an upload session",
        "tags": [
          "asset"
        ]
      }
    },
    "/asset/upload/{upload_id}/chunk/{chunk_number}": {
      "put": {
        "description": "The request body carries the raw bytes of the chunk. The `Content-Range`\nheader declares the inclusive byte range as `bytes {start}-{end}/{total}` and\nthe `Content-MD5` header carries the lowercase hexadecimal MD5 digest of the\nbody. The chunk is idempotent: re-uploading it with the same digest succeeds\nwithout changing the stored content.",
        "operationId": "put_upload_chunk",
        "parameters": [
          {
            "description": "Identifier of the upload session",
            "in": "path",
            "name": "upload_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/i64"
            }
          },
          {
            "description": "Zero-based number of the chunk",
            "in": "path",
            "name": "chunk_number",
            "required": true,
            "schema": {
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "Inclusive byte range, `bytes {start}-{end}/{total}`",
            "in": "header",
            "name": "Content-Range",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Lowercase hexadecimal MD5 digest of the chunk",
            "in": "header",
            "name": "Content-MD5",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/octet-stream": {
              "schema": {
                "$ref": "#/components/schemas/PutUploadChunkRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PutUploadChunkResponse"
                }
              }
            },
            "description": "Chunk stored"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Invalid identifier, chunk number, range, digest or body"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Missing or invalid credentials"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unknown upload session"
          },
          "409": {
