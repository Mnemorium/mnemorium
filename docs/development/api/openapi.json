{
  "components": {
    "schemas": {
      "ErrorBody": {
        "description": "Standard error payload returned by every failed request.",
        "properties": {
          "error": {
            "description": "Human-readable description of the error.",
            "example": "An error message",
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "GetListUserResponse": {
        "description": "User returned by a successful lookup.",
        "properties": {
          "email": {
            "description": "Email address of the user, when one was provided.",
            "format": "email",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "$ref": "#/components/schemas/i64",
            "description": "Unique identifier of the user."
          },
          "role": {
            "$ref": "#/components/schemas/Role",
            "description": "Role of the user."
          },
          "username": {
            "description": "Username of the user.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "role",
          "username"
        ],
        "type": "object"
      },
      "GetMeResponse": {
        "description": "Current user returned by a successful lookup.",
        "properties": {
          "email": {
            "description": "Email address of the caller, when one was provided.",
            "format": "email",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "$ref": "#/components/schemas/i64",
            "description": "Unique identifier of the caller."
          },
          "role": {
            "$ref": "#/components/schemas/Role",
            "description": "Role of the caller."
          },
          "username": {
            "description": "Username of the caller.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "role",
          "username"
        ],
        "type": "object"
      },
      "GetUserResponse": {
        "description": "User returned by a successful lookup.",
        "properties": {
          "email": {
            "description": "Email address of the user, when one was provided.",
            "format": "email",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "$ref": "#/components/schemas/i64",
            "description": "Unique identifier of the user."
          },
          "role": {
            "$ref": "#/components/schemas/Role",
            "description": "Role of the user."
          },
          "username": {
            "description": "Username of the user.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "role",
          "username"
        ],
        "type": "object"
      },
      "HealthResponse": {
        "description": "Service health status.",
        "properties": {
          "status": {
            "description": "Service status.",
            "example": "ok",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "LoginRequest": {
        "description": "Payload to authenticate a user.",
        "properties": {
          "password": {
            "description": "Password used to authenticate.",
            "type": "string",
            "writeOnly": true
          },
          "username": {
            "description": "Username of the user to authenticate.",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "password",
          "username"
        ],
        "type": "object"
      },
      "LoginResponse": {
        "description": "Token issued by a successful authentication.",
        "properties": {
          "access_token": {
            "description": "Token to present in the `Authorization` header of subsequent requests.",
            "type": "string"
          },
          "expires_in": {
            "description": "Lifetime of the token, in seconds.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "token_type": {
            "description": "Token type, always `bearer`.",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "expires_in",
          "token_type"
        ],
        "type": "object"
      },
      "RegisterRequest": {
        "description": "Payload to register a new user.\n\nThe requested `role` is granted only when the authenticated caller is\nallowed to create it: the Root Admin can register `Admin` or `Standard`\nusers, an `Admin` user can register `Standard` users only.",
        "properties": {
          "email": {
            "description": "Email address of the new user, when provided.",
            "format": "email",
            "type": [
              "string",
              "null"
            ]
          },
          "password": {
            "description": "Password of the new user; never returned by the API.\n\nMust be at least 8 characters long and contain at least one symbol\n(a non-alphanumeric character).",
            "minLength": 8,
            "pattern": "[^A-Za-z0-9]",
            "type": "string",
            "writeOnly": true
          },
          "role": {
            "$ref": "#/components/schemas/Role",
            "description": "Role to grant to the new user."
          },
          "username": {
            "description": "Username of the new user.",
            "maxLength": 100,
            "minLength": 4,
            "type": "string"
          }
        },
        "required": [
          "password",
          "role",
          "username"
        ],
        "type": "object"
      },
      "RegisterResponse": {
        "description": "User created by a successful registration.",
        "properties": {
          "email": {
            "description": "Email address of the newly registered user, when one was provided.",
            "format": "email",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "$ref": "#/components/schemas/i64",
            "description": "Unique identifier of the newly registered user."
          },
          "role": {
            "$ref": "#/components/schemas/Role",
            "description": "Role granted to the newly registered user."
          },
          "username": {
            "description": "Username of the newly registered user.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "role",
          "username"
        ],
        "type": "object"
      },
      "Role": {
        "description": "Role of a `User`.",
        "enum": [
          "ADMIN",
          "STANDARD"
        ],
        "type": "string"
      },
      "i64": {
        "format": "int64",
        "type": "integer"
      }
    },
    "securitySchemes": {
      "bearer_auth": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "HTTP API of the Mnemorium service",
    "license": {
      "identifier": "MIT",
      "name": "MIT"
    },
    "title": "Mnemorium API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Returns `200` with the current health status when the service is running.",
        "operationId": "get_health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Service is healthy"
          }
        },
        "servers": [
          {
            "description": "Root of the service, outside /api/v1",
            "url": "http://0.0.0.0:4080"
          }
        ],
        "summary": "Check service health",
        "tags": [
          "system"
        ]
      }
    },
    "/identity/login": {
      "post": {
        "description": "The caller presents a username and a password. On success the endpoint\nreturns an access token to present in the `Authorization` header of\nsubsequent requests, together with the number of seconds it stays valid.",
        "operationId": "post_login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            },
            "description": "User authenticated"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Invalid payload"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Invalid credentials"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unexpected error"
          }
        },
        "summary": "Authenticate a user",
        "tags": [
          "identity"
        ]
      }
    },
    "/identity/register": {
      "post": {
        "description": "The Root Admin (user identifier `0`) may register `Admin` or `Standard`\nusers; an `Admin` user may register `Standard` users only; any other role is\nrejected with `403`.",
        "operationId": "post_register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterResponse"
                }
              }
            },
            "description": "User registered",
            "headers": {
              "Location": {
                "description": "URI of the newly registered user",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Invalid payload"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Missing or invalid credentials"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Insufficient privileges to register the requested role"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Username or email is already taken"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unexpected error"
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ],
        "summary": "Register a new user",
        "tags": [
          "identity"
        ]
      }
    },
    "/user": {
      "get": {
        "description": "Requires an `Admin` caller. Returns the profiles of every user matching\nthe optional filters. An empty list is a valid outcome.",
        "operationId": "list_users",
        "parameters": [
          {
            "description": "Only return users whose email matches this value.",
            "in": "query",
            "name": "email",
            "required": false,
            "schema": {
              "format": "email",
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "description": "Only return users holding this role.",
            "in": "query",
            "name": "role",
            "required": false,
            "schema": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/components/schemas/Role"
                }
              ]
            }
          },
          {
            "description": "Only return users whose username matches this value.",
            "in": "query",
            "name": "username",
            "required": false,
            "schema": {
              "maxLength": 100,
              "minLength": 4,
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/GetListUserResponse"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Users matching the filters"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Invalid filter values"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Missing or invalid credentials"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Caller is not an administrator"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unexpected error"
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ],
        "summary": "List users",
        "tags": [
          "user"
        ]
      }
    },
    "/user/me": {
      "get": {
        "description": "Returns the caller's own profile — identifier, username, email and role.",
        "operationId": "get_me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetMeResponse"
                }
              }
            },
            "description": "Current user"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Missing or invalid credentials"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unexpected error"
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ],
        "summary": "Fetch the current user",
        "tags": [
          "user"
        ]
      }
    },
    "/user/{id}": {
      "get": {
        "description": "Requires an `Admin` caller. Returns the profile — identifier, username,\nemail and role — of the requested user.",
        "operationId": "get_user",
        "parameters": [
          {
            "description": "Identifier of the user to fetch",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/i64"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetUserResponse"
                }
              }
            },
            "description": "User found"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Invalid user identifier"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Missing or invalid credentials"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Caller is not an administrator"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unknown user"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unexpected error"
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ],
        "summary": "Fetch a user by identifier",
        "tags": [
          "user"
        ]
      }
    }
  },
  "servers": [
    {
      "description": "Local development server",
      "url": "http://0.0.0.0:4080/api/v1"
    }
  ],
  "tags": [
    {
      "description": "System-level endpoints",
      "name": "system"
    },
    {
      "description": "Identity bounded context",
      "name": "identity"
    },
    {
      "description": "User bounded context",
      "name": "user"
    }
  ]
}