{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "edit",
      "resource": "Cargo.toml",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "clippy.toml",
      "effect": "deny"
    },
    {
        "action": "edit",
        "resource": "deny.toml",
        "effect": "deny"
    }
  ],
  "mcp": {
    "servers": {
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_MCP_TOKEN}",
          "X-MCP-Toolsets": "issues,pull_requests"
        }
      }
    }
  }
}
