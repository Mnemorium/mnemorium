{
    "branches": ["main"],
    "plugins": [
        [
            "@semantic-release/commit-analyzer",
            {
                "preset": "conventionalcommits"
            }
        ],
        [
            "@semantic-release/release-notes-generator",
            {
                "preset": "conventionalcommits"
            }
        ],
        [
            "@semantic-release/changelog",
            {
                "changelogFile": "CHANGELOG.md"
            }
        ],
        [
            "@semantic-release/exec",
            {
                "prepareCmd": "script/version.sh set \"${nextRelease.version}\" && cargo update --workspace && docker buildx build --load --tag wpelletier/mnemorium --cache-from type=local,src=/tmp/.buildx-cache-release --cache-to type=local,dest=/tmp/.buildx-cache-release-new,mode=max ."
            }
        ],
        [
            "@semantic-release/git",
            {
                "assets": ["CHANGELOG.md", "docs/openapi.json", "Cargo.toml", "Cargo.lock"]
            }
        ],
        [
            "@semantic-release/github",
            {
                "successCommentCondition": false,
                "failCommentCondition": false,
                "releasedLabels": false
            }
        ],
        [
            "@semantic-release-plus/docker",
            {
                "skipLogin": true,
                "name": "wpelletier/mnemorium"
            }
        ]
    ]
}
