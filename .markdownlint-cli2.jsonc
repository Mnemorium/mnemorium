{
    "config": {
        "MD013": {
            "line_length": 120,
            "code_blocks": false,
            "tables": false
        },

        "MD024": false,

        "MD033": {
            "allowed_elements": [
                "a",
                "br",
                "details",
                "div",
                "em",
                "h1",
                "img",
                "p",
                "span",
                "summary"
            ]
        },

        "MD041": false
    },
    "ignores": [
        ".devenv/",
        "target/",
        "site/",
        ".artifacts/",
        ".pytest_cache/",
        ".agents/",
        ".opencode/",
        "AGENTS.md",
        "CHANGELOG.md",
    ]

}
